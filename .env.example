# PL/SQL Lens environment variables (names only; never commit values).
# F1 needs none. Later phases:
# ANTHROPIC_API_KEY=   # optional: enables the anthropic-api LLM backend (F2+)
# F3 (Oracle integration; generated at container start, never committed):
# ORACLE_PASSWORD=       # SYS/PLLT/UT3 password of the throw-away container (docker/up.sh creates one)
# PLSQL_LENS_SQLPLUS=    # shell command that runs sqlplus as PLLT (see docker/README.md)
